# ---- 工具链 / 依赖（本地便携工具，不进仓库） ----
tools/
web/node_modules/

# ---- 构建产物（build.bat / build.sh 生成） ----
# out/ 是交付目录，装配出的可执行文件在这里。构建脚本故意不删除它 ——
# 用户可能已经把 out/ 当部署目录跑过，里面会有真实的 data/。绝不能提交。
out/
web/dist/
server/internal/web/dist/*
!server/internal/web/dist/.keep
server/cloudpan.exe
server/cloudpan
server/cloudpan.exe~

# ---- 运行数据（数据库 / 密钥 / 存储挂载根，绝不可提交） ----
server/data/
C/
D/

# ---- 日志与临时文件 ----
*.log
*.zip
*.tmp
*.rar
*.7z
*.tar
*.tar.gz
nohup.out

# ---- IDE / 本地状态 ----
.mimosa/
.zcode/
.DS_Store
Thumbs.db
server/cloudpan-linux

# ---- 本地交叉编译的验证产物（自己编着玩的，不进仓库） ----
.build-tmp/

# ---- IDE ----
.trae/
